PCT_APP_ENV=dev
PCT_APP_MODE=prod
PCT_AUTH_MODE=sms
PCT_ENABLE_SMS_LOGIN=true
PCT_SHOW_DEMO_BANNER=false
PCT_ENABLE_SAMPLE_TASKS=false
PCT_ALLOW_USER_UPLOAD=true
PCT_ENABLE_REAL_COST_FEATURES=true
PCT_DEMO_USER_PHONE=13800138000
PCT_DEMO_USER_NICKNAME=PodFlow Local Real
PCT_DEFAULT_MONTHLY_QUOTA=5

PCT_SECRET_KEY=change-me-local-real
PCT_CREDENTIALS_ENCRYPTION_KEY=
PCT_AUTO_MIGRATE_ON_STARTUP=true

# docker-compose.yml overrides these to container-internal hosts.
PCT_DATABASE_URL=postgresql+asyncpg://postgres:postgres_password@localhost:5432/podcast_translator
PCT_REDIS_URL=redis://localhost:6379/0
PCT_S3_ENDPOINT=http://localhost:9000
PCT_S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
PCT_S3_BUCKET=podcast-translator-audio
PCT_S3_ACCESS_KEY=admin
PCT_S3_SECRET_KEY=minio_password

PCT_PIPELINE_MODE=real
PCT_ASR_PROVIDER=whisper
PCT_ASR_MODEL=medium
PCT_ASR_DEVICE=auto
PCT_ASR_COMPUTE_TYPE=default
PCT_ASR_BEAM_SIZE=5
PCT_TTS_PROVIDER=cosyvoice
# Voice clone engine: elevenlabs (commercial API) | voxcpm (self-hosted) | cosyvoice
PCT_VOICE_CLONE_PROVIDER=elevenlabs
# VoxCPM (self-hosted, zero-shot, no API key) — acceptance-comparison alternative to ElevenLabs.
# Requires a GPU worker and `pip install -e .[pipeline,voxcpm]`. Set PCT_VOICE_CLONE_PROVIDER=voxcpm to use it.
PCT_VOXCPM_MODEL=openbmb/VoxCPM-0.5B
PCT_VOXCPM_DEVICE=auto
PCT_VOXCPM_CFG_VALUE=2.0
PCT_VOXCPM_INFERENCE_TIMESTEPS=10
PCT_VOXCPM_DENOISE=true
PCT_ELEVENLABS_API_KEY=replace-with-elevenlabs-api-key
PCT_ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
PCT_ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
PCT_ELEVENLABS_TIMEOUT_SECONDS=60
PCT_ELEVENLABS_MAX_RETRIES=3
PCT_ELEVENLABS_REMOVE_BACKGROUND_NOISE=true
PCT_VOICE_CLONE_RETENTION_DAYS=7
PCT_REQUIRE_VOICE_CLONE_CONSENT=false
PCT_COSYVOICE_MODEL=cosyvoice-v2
PCT_COSYVOICE_FALLBACK_VOICE=longxiaochun_v2
PCT_COSYVOICE_FALLBACK_VOICE_MALE=longxiaocheng_v2
PCT_COSYVOICE_FALLBACK_VOICE_FEMALE=longxiaochun_v2
PCT_COSYVOICE_ENABLE_ENROLLMENT=true
PCT_COSYVOICE_ENROLLMENT_PREFIX=podflow
PCT_DASHSCOPE_TTS_TIMEOUT_MILLIS=30000
PCT_DASHSCOPE_TTS_MAX_RETRIES=10
PCT_DASHSCOPE_TTS_RETRY_BACKOFF_SECONDS=4.0
PCT_DASHSCOPE_TTS_SEGMENT_DELAY_SECONDS=1.0
PCT_TRANSLATION_PROVIDER=deepseek
PCT_PIPELINE_TASK_TIME_LIMIT_SECONDS=172800
PCT_PIPELINE_TASK_SOFT_TIME_LIMIT_SECONDS=169200
PCT_ENABLE_STALL_RECONCILER=false
PCT_WORKER_HEARTBEAT_INTERVAL_SECONDS=30
PCT_WORKER_LOCK_TTL_SECONDS=300
PCT_TASK_STALL_TIMEOUT_SECONDS=900
PCT_TASK_STALL_CONFIRMATION_SECONDS=300
PCT_TASK_STALL_SCAN_INTERVAL_SECONDS=60
PCT_TASK_STALL_SCAN_BATCH_SIZE=100
PCT_ENABLE_LONG_AUDIO_PIPELINE=true
PCT_LONG_AUDIO_THRESHOLD_SECONDS=1800
PCT_MAX_AUDIO_DURATION_SECONDS=18000
PCT_MAX_UPLOAD_BYTES=5368709120
PCT_AUDIO_CHUNK_SECONDS=600
PCT_AUDIO_CHUNK_OVERLAP_SECONDS=5

# Demucs source separation memory controls. htdemucs (single model) avoids the OOM that
# htdemucs_ft (4-model bag) causes on ~8GB CPU workers; --segment bounds peak memory.
# Set PCT_DEMUCS_MODEL=htdemucs_ft to trade memory for slightly higher quality.
PCT_DEMUCS_MODEL=htdemucs
PCT_DEMUCS_SEGMENT_SECONDS=7
PCT_DEMUCS_JOBS=1
# PCT_DEMUCS_DEVICE=cpu   # leave unset to autodetect (cuda if available)
PCT_TRANSLATION_BATCH_SIZE=20
PCT_TTS_BATCH_SIZE=20

PCT_OPENAI_API_KEY=
PCT_OPENAI_BASE_URL=
PCT_DEEPSEEK_API_KEY=replace-with-deepseek-api-key
PCT_DEEPSEEK_BASE_URL=https://api.deepseek.com
PCT_HF_TOKEN=replace-with-huggingface-token
PCT_DASHSCOPE_API_KEY=replace-with-dashscope-api-key

# Keep local auth cheap while validating the real audio pipeline.
# For real SMS set PCT_SMS_PROVIDER=aliyun and fill the AccessKey/sign/template below
# (also `pip install alibabacloud_dysmsapi20170525`). Codes are stored in Redis with
# TTL/cooldown/attempt limits; mock keeps the fixed code 123456.
PCT_SMS_PROVIDER=mock
# PCT_SMS_ACCESS_KEY_ID=replace-with-aliyun-access-key-id
# PCT_SMS_ACCESS_KEY_SECRET=replace-with-aliyun-access-key-secret
# PCT_SMS_SIGN_NAME=replace-with-sign-name
# PCT_SMS_TEMPLATE_CODE=SMS_xxxxxxxx
# PCT_SMS_CODE_TTL_SECONDS=300
# PCT_SMS_CODE_COOLDOWN_SECONDS=60
# PCT_SMS_MAX_VERIFY_ATTEMPTS=5

# WeChat login is a mock placeholder — keep disabled until real OAuth lands.
PCT_ENABLE_WECHAT_LOGIN=false

# Production admission controls (0 / empty = unlimited / allow-all).
PCT_MAX_ACTIVE_TASKS_PER_USER=0
PCT_SMS_PHONE_ALLOWLIST=

# ElevenLabs voice retention sweep cadence (hours; <=0 disables the celery beat task).
PCT_VOICE_CLONE_CLEANUP_INTERVAL_HOURS=24

PCT_FRONTEND_PROXY_TARGET=http://backend:8000
NEXT_PUBLIC_PCT_API_ORIGIN=http://127.0.0.1:8000
NEXT_PUBLIC_PCT_UPLOAD_API_ORIGIN=http://127.0.0.1:8000
NEXT_PUBLIC_PCT_APP_MODE=prod
NEXT_PUBLIC_PCT_AUTH_MODE=sms
NEXT_PUBLIC_PCT_SHOW_DEMO_BANNER=false
NEXT_PUBLIC_PCT_ENABLE_SAMPLE_TASKS=false
NEXT_PUBLIC_PCT_ALLOW_USER_UPLOAD=true

APT_MIRROR_HOST=
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
PIP_TRUSTED_HOST=mirrors.aliyun.com
PIP_DEFAULT_TIMEOUT=600
PIP_RETRIES=15
PIP_TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
PIP_TORCH_PACKAGES=torch==2.2.2+cpu torchaudio==2.2.2+cpu
