FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

ARG APT_MIRROR_HOST=mirrors.aliyun.com
ARG PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
ARG PIP_TRUSTED_HOST=mirrors.aliyun.com
ARG PIP_DEFAULT_TIMEOUT=120

RUN if [ -n "$APT_MIRROR_HOST" ]; then \
      if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
        sed -i "s|http://deb.debian.org|http://${APT_MIRROR_HOST}|g; s|http://security.debian.org|http://${APT_MIRROR_HOST}|g" /etc/apt/sources.list.d/debian.sources; \
      fi; \
      if [ -f /etc/apt/sources.list ]; then \
        sed -i "s|http://deb.debian.org|http://${APT_MIRROR_HOST}|g; s|http://security.debian.org|http://${APT_MIRROR_HOST}|g" /etc/apt/sources.list; \
      fi; \
    fi \
    && apt-get update \
    && apt-get install -y --no-install-recommends build-essential curl ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md alembic.ini /app/
COPY migrations /app/migrations
COPY src /app/src

RUN pip config set global.index-url "${PIP_INDEX_URL}" \
    && pip config set global.trusted-host "${PIP_TRUSTED_HOST}" \
    && pip config set global.default-timeout "${PIP_DEFAULT_TIMEOUT}" \
    && pip install --upgrade pip \
    && pip install -e .

CMD ["celery", "-A", "src.workers.celery_app:celery_app", "worker", "--loglevel=info"]
