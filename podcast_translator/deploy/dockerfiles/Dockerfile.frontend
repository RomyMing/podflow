FROM node:20-alpine AS deps

WORKDIR /app

ARG NPM_REGISTRY=https://registry.npmmirror.com

COPY frontend/package*.json ./
RUN npm config set registry ${NPM_REGISTRY} \
    && npm ci

FROM node:20-alpine AS builder

WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
ARG PCT_FRONTEND_PROXY_TARGET=http://backend:8000
ARG NEXT_PUBLIC_PCT_API_ORIGIN=
ARG NEXT_PUBLIC_PCT_UPLOAD_API_ORIGIN=
ARG NEXT_PUBLIC_PCT_APP_MODE=prod
ARG NEXT_PUBLIC_PCT_AUTH_MODE=sms
ARG NEXT_PUBLIC_PCT_SHOW_DEMO_BANNER=false
ARG NEXT_PUBLIC_PCT_ENABLE_SAMPLE_TASKS=false
ARG NEXT_PUBLIC_PCT_ALLOW_USER_UPLOAD=true
ENV PCT_FRONTEND_PROXY_TARGET=${PCT_FRONTEND_PROXY_TARGET} \
    NEXT_PUBLIC_PCT_API_ORIGIN=${NEXT_PUBLIC_PCT_API_ORIGIN} \
    NEXT_PUBLIC_PCT_UPLOAD_API_ORIGIN=${NEXT_PUBLIC_PCT_UPLOAD_API_ORIGIN} \
    NEXT_PUBLIC_PCT_APP_MODE=${NEXT_PUBLIC_PCT_APP_MODE} \
    NEXT_PUBLIC_PCT_AUTH_MODE=${NEXT_PUBLIC_PCT_AUTH_MODE} \
    NEXT_PUBLIC_PCT_SHOW_DEMO_BANNER=${NEXT_PUBLIC_PCT_SHOW_DEMO_BANNER} \
    NEXT_PUBLIC_PCT_ENABLE_SAMPLE_TASKS=${NEXT_PUBLIC_PCT_ENABLE_SAMPLE_TASKS} \
    NEXT_PUBLIC_PCT_ALLOW_USER_UPLOAD=${NEXT_PUBLIC_PCT_ALLOW_USER_UPLOAD}

COPY --from=deps /app/node_modules ./node_modules
COPY frontend .
RUN npm run build

FROM node:20-alpine AS runner

WORKDIR /app
ARG PCT_FRONTEND_PROXY_TARGET=http://backend:8000
ARG NEXT_PUBLIC_PCT_API_ORIGIN=
ARG NEXT_PUBLIC_PCT_UPLOAD_API_ORIGIN=
ARG NEXT_PUBLIC_PCT_APP_MODE=prod
ARG NEXT_PUBLIC_PCT_AUTH_MODE=sms
ARG NEXT_PUBLIC_PCT_SHOW_DEMO_BANNER=false
ARG NEXT_PUBLIC_PCT_ENABLE_SAMPLE_TASKS=false
ARG NEXT_PUBLIC_PCT_ALLOW_USER_UPLOAD=true
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PCT_FRONTEND_PROXY_TARGET=${PCT_FRONTEND_PROXY_TARGET} \
    NEXT_PUBLIC_PCT_API_ORIGIN=${NEXT_PUBLIC_PCT_API_ORIGIN} \
    NEXT_PUBLIC_PCT_UPLOAD_API_ORIGIN=${NEXT_PUBLIC_PCT_UPLOAD_API_ORIGIN} \
    NEXT_PUBLIC_PCT_APP_MODE=${NEXT_PUBLIC_PCT_APP_MODE} \
    NEXT_PUBLIC_PCT_AUTH_MODE=${NEXT_PUBLIC_PCT_AUTH_MODE} \
    NEXT_PUBLIC_PCT_SHOW_DEMO_BANNER=${NEXT_PUBLIC_PCT_SHOW_DEMO_BANNER} \
    NEXT_PUBLIC_PCT_ENABLE_SAMPLE_TASKS=${NEXT_PUBLIC_PCT_ENABLE_SAMPLE_TASKS} \
    NEXT_PUBLIC_PCT_ALLOW_USER_UPLOAD=${NEXT_PUBLIC_PCT_ALLOW_USER_UPLOAD} \
    PORT=3000 \
    HOSTNAME=0.0.0.0

COPY --from=builder /app/package*.json ./
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public
COPY --from=builder /app/node_modules ./node_modules

EXPOSE 3000

CMD ["npm", "run", "start", "--", "--hostname", "0.0.0.0", "--port", "3000"]
