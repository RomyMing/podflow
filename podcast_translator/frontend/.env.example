# Optional override for browser-side API requests.
# When set, auth/task/user requests go directly to this backend origin/base URL.
NEXT_PUBLIC_PCT_API_ORIGIN=http://127.0.0.1:8000

# Optional override for large uploads during `next dev`.
# When omitted, uploads reuse NEXT_PUBLIC_PCT_API_ORIGIN if present.
NEXT_PUBLIC_PCT_UPLOAD_API_ORIGIN=http://127.0.0.1:8000

# Demo/prod experience switches for the frontend bundle.
NEXT_PUBLIC_PCT_APP_MODE=prod
NEXT_PUBLIC_PCT_AUTH_MODE=sms
NEXT_PUBLIC_PCT_SHOW_DEMO_BANNER=false
NEXT_PUBLIC_PCT_ENABLE_SAMPLE_TASKS=false
NEXT_PUBLIC_PCT_ALLOW_USER_UPLOAD=true
